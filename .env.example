# SplitX backend environment
# Copy to .env and fill in real values. NEVER commit real credentials.

PORT=3000

# MongoDB connection string.
# Local docker: mongodb://mongo:27017/splitx
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGO_URL=mongodb://mongo:27017/splitx

# JWT signing secret
TOKEN_KEY=change-me

# Frontend URL used in invite emails
APP_URL=http://localhost:8081

# Comma-separated list of allowed CORS origins
# ALLOWED_ORIGINS=https://app.example.com

# SMTP (optional — emails are logged if unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SplitX <noreply@splitx.app>

# Required (=yes) to run database/Seeder.js — it wipes seed data
# SEED_CONFIRM=yes
